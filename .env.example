# =============================================================================
# MyProjectory (CareerStack AI) – Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env or any file containing real secrets to version control.
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# MySQL connection URL used by Drizzle ORM.
# Format: mysql://user:password@host:port/database
# For local Docker: mysql://careerstack:careerstack@localhost:3307/careerstack
# For production cPanel: mysql2://user:password@hostname:3306/dbname
DATABASE_URL=mysql://careerstack:careerstack@localhost:3307/careerstack

# Docker MySQL container credentials (must match docker-compose.yml)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=careerstack
MYSQL_USER=careerstack
MYSQL_PASSWORD=careerstack

# ─── Server ──────────────────────────────────────────────────────────────────
# Port the Express API server listens on.
PORT=3001

# Frontend dev server port (used by the Vite dev proxy).
FRONTEND_PORT=5173

# "development" or "production"
NODE_ENV=development

# When "true" in development mode, skips Clerk verification and auto-authenticates
# as a mock admin user.  Must be "false" or unset in production.
SKIP_ADMIN_CHECK=true

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Clerk Authentication ────────────────────────────────────────────────────
# Frontend (Vite) – prefixed with VITE_ so they are exposed to client code.
# Get these from your Clerk dashboard: https://dashboard.clerk.com
#
# If this key is missing in development, the app renders a "Dev mode (no Clerk)"
# banner and skips authentication — all routes are accessible.
# In production, a missing key will cause a crash.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend (API server) – NEVER exposed to the frontend.
CLERK_SECRET_KEY=sk_test_...

# ─── SerpAPI ─────────────────────────────────────────────────────────────────
# API key for market-intelligence job searches.
# Get one at https://serpapi.com  (free tier: 100 searches/month)
SERPAPI_API_KEY=

# ─── Adzuna (optional – used by the job-sync cron) ──────────────────────────
ADZUNA_APP_ID=
ADZUNA_API_KEY=
ADZUNA_REGION=in

# ─── Job Sync Scheduler ─────────────────────────────────────────────────────
# Cron expression for periodic job fetching (default: daily at midnight).
JOBS_SYNC_INTERVAL=0 0 * * *

# Set to "true" to auto-start the scraper scheduler on server boot.
JOB_INTEL_SCHEDULER_ENABLED=false

# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Base public path for Vite (use "/" for root, "/app/" for sub-path deploys).
BASE_PATH=/

# In production, if the API is served from a different origin, set this so the
# generated API client prepends it to every request.  Leave empty when the API
# is proxied under the same origin (e.g. via Apache /api/* → Node).
VITE_API_URL=

# Dev-server proxy target for /api requests (defaults to http://localhost:3001).
VITE_API_TARGET=http://localhost:3001

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins in production.
# In development all origins are allowed.
CORS_ORIGIN=https://projectory.com,https://www.projectory.com

# ─── Production-specific notes ──────────────────────────────────────────────
# On cPanel you will set these via the cPanel UI or .env.production:
#
#   DATABASE_URL=mysql2://prod_user:prod_pass@hostname:3306/prod_dbname
#   CLERK_SECRET_KEY=sk_live_...
#   SERPAPI_API_KEY=your_key
#   NODE_ENV=production
#   PORT=3001
#   SKIP_ADMIN_CHECK=false
#
# Frontend env vars (VITE_*) are baked into the build at `vite build` time.
# Set them in your shell or .env before running: pnpm --filter @workspace/careerstack run build
